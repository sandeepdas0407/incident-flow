# --- ServiceNow (Personal Developer Instance) ---
SN_INSTANCE_URL=https://devXXXXX.service-now.com
SN_USERNAME=incidentflow.integration
SN_PASSWORD=change-me
# Tickets assigned to this group are picked up by the agents
SN_INTAKE_GROUP=AI Ops
# Group that receives hand-offs when the agent can't (or shouldn't) fix something
SN_HUMAN_GROUP=Service Desk
# user_name of the sys_user that represents the agent
SN_AGENT_USER=ai.ops.agent
# Incident close code: must match a value on your instance (run scripts.check_servicenow to list them)
SN_INCIDENT_CLOSE_CODE=Resolved – Permanent Fix Applied

# --- GitHub ---
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=your-org/incident-flow-demo-app
GITHUB_BASE_BRANCH=main

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=medium
# the service desk chatbot (lower = snappier replies)
CHAT_EFFORT=low

# --- Agent behaviour ---
SN_POLL_SECONDS=10
GH_POLL_SECONDS=15
TRIAGE_MIN_CONFIDENCE=0.7
# follow-up fix PRs after a failed post-deploy validation, then a human takes over
MAX_FIX_ATTEMPTS=2
APP_URL=http://incidentflow-demo.eastus.cloudapp.azure.com
DATABASE_URL=sqlite:///./incident_flow.db

# --- Azure (read-only, for post-deploy validation; uses the local `az login`) ---
AZURE_RESOURCE_GROUP=incidentflow-rg
AZURE_VM_NAME=incidentflow-vm
AZURE_NSG_NAME=incidentflow-nsg
